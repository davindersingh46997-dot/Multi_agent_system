APP_ENV=development
DATABASE_URL=sqlite:///./multi_agent.db
PROJECTS_ROOT=workspace
UPLOADS_ROOT=.multi_agent/uploads

# Add your model provider, model identifier, and key when you choose them.
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=

# Optional in development; required in production.
AUTH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_BYTES=8000000
MAX_IMAGE_PIXELS=25000000