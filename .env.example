APP_ENV=development
DATABASE_URL=sqlite:///./multi_agent.db
PROJECTS_ROOT=workspace
UPLOADS_ROOT=.multi_agent/uploads

# Optional model settings for the project-aware task workflow.
MODEL_PROVIDER=
MODEL_NAME=
MODEL_API_KEY=
MODEL_BASE_URL=

# Hugging Face Inference Providers for standalone file generation.
HF_TOKEN=
HF_INFERENCE_PROVIDER=auto
HF_DEFAULT_MODEL=
HF_REQUIREMENTS_MODEL=
HF_PLANNER_MODEL=
HF_PROGRAMMER_MODEL=
HF_REVIEWER_MODEL=
HF_VALIDATOR_MODEL=
HF_INFERENCE_TIMEOUT_SECONDS=90
GENERATION_MAX_REVISION_ROUNDS=2
MAX_GENERATION_OUTPUT_BYTES=1000000
GENERATED_ARTIFACT_RETENTION_DAYS=7
GENERATION_TASK_LEASE_SECONDS=600
GENERATION_WORKER_POLL_SECONDS=1

# Optional in development; required in production.
AUTH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_BYTES=8000000
MAX_IMAGE_PIXELS=25000000